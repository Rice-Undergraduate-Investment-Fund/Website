# Copy to .env.local (never commit .env.local).

# Only needed for `npm run seed` / `npm run seed:clean`.
# Create at sanity.io/manage → project → API → Tokens → "Add API token" (Editor).
SANITY_API_WRITE_TOKEN=

# Netlify only (not needed locally): secret shared with the Sanity webhook
# SANITY_REVALIDATE_SECRET=

# Optional overrides (defaults live in sanity/env.ts)
# NEXT_PUBLIC_SANITY_PROJECT_ID=237x8krw
# NEXT_PUBLIC_SANITY_DATASET=production
